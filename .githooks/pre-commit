#!/usr/bin/env bash
#
# pre-commit — gate commits on typecheck + tests.
#
# Installed via `core.hooksPath` (see `npm run hooks:install`), so this file is
# version-controlled and survives a fresh clone — unlike anything dropped in
# .git/hooks.
#
# Bypass with `git commit --no-verify` when you genuinely need to (WIP commits
# on a throwaway branch, docs-only fixups mid-rebase).
#
# Exit 0 = allow the commit, exit 1 = block it.

set -uo pipefail

# Docs-only commits do not need a typecheck or a test run. If every staged path
# is markdown or a licence/text file, skip the gate entirely.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi
if ! printf '%s\n' "$staged" | grep -qvE '\.(md|txt)$|^LICENSE$'; then
  echo "🐢 pre-commit: docs-only change — skipping typecheck + tests."
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

failed=()

run_check() {
  local label=$1
  shift
  printf '🐢 pre-commit: %s… ' "$label"
  local output
  if output=$("$@" 2>&1); then
    echo "ok"
  else
    echo "FAILED"
    # Only the tail is useful; the full run is reproducible with the same command.
    printf '%s\n' "$output" | tail -30
    failed+=("$label")
  fi
}

run_check "typecheck" npm run typecheck
run_check "tests" npm test

if [ ${#failed[@]} -gt 0 ]; then
  echo
  echo "🍕 Hold the pizza — ${failed[*]} failed. Commit blocked."
  echo "   Fix the errors above, or bypass with: git commit --no-verify"
  exit 1
fi

echo "🐢 Cowabunga — checks passed."
exit 0
