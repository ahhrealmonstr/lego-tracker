#!/usr/bin/env bash
#
# pre-commit — gate commits on typecheck + tests, and markdown on markdownlint.
#
# Installed via `core.hooksPath` (see `npm run hooks:install`), so this file is
# version-controlled and survives a fresh clone — unlike anything dropped in
# .git/hooks.
#
# SCOPE CAVEAT: these checks run against the WORKING TREE, not the staged index.
# A partially-staged commit is validated against what is on disk, which may differ
# from what actually gets committed. Closing that gap properly needs
# `git stash --keep-index`, whose failure modes inside a hook are worse than the
# gap itself. Do not read a green result as "the committed tree passes".
#
# `lint:md` widens that caveat: it lints the repo-wide glob, not just the staged
# markdown. So a docs commit can be blocked by an unrelated broken .md elsewhere
# in the tree. That is tolerable only because the baseline is zero errors — if it
# ever drifts back above zero, every docs commit blocks until it is fixed.
#
# Bypass with `git commit --no-verify`.
#
# Exit 0 = allow the commit, exit 1 = block it.

set -uo pipefail

repo_root=$(git rev-parse --show-toplevel) || exit 1
[ -n "$repo_root" ] || exit 1
cd "$repo_root" || exit 1

# No --diff-filter here, deliberately. An earlier revision used --diff-filter=ACMR,
# which excludes deletions (D) and typechanges (T) — so `git rm src/foo.ts` staged
# nothing the hook could see and the gate never ran, despite deleting a module
# being one of the most reliable ways to break a typecheck.
# --no-renames keeps both sides of a rename visible, so `git mv src/x.ts docs/x.md`
# cannot masquerade as a docs-only change by reporting only its destination.
staged=$(git diff --cached --name-only --no-renames)
if [ -z "$staged" ]; then
  exit 0
fi

# Two independent questions, deliberately not collapsed into one:
#   - any non-doc file staged?  -> typecheck + tests must run
#   - any markdown staged?      -> markdownlint must run
# Neither implies the other. Markdown cannot break a typecheck, and a .ts file
# cannot break markdownlint. A mixed commit answers yes to both and gets both —
# without that, any markdown could reach main by riding along with a source file,
# which is how most markdown in this repo is actually committed.
#
# `.txt` is deliberately excluded from the docs list — test fixtures are commonly
# .txt and must gate. LICENSE matches at any depth, not just the repo root.
needs_source_gate=0
needs_md_lint=0
printf '%s\n' "$staged" | grep -qvE '\.md$|(^|/)LICENSE$' && needs_source_gate=1
printf '%s\n' "$staged" | grep -qE '\.md$' && needs_md_lint=1

if [ "$needs_source_gate" -eq 0 ] && [ "$needs_md_lint" -eq 0 ]; then
  echo "🐢 pre-commit: no source and no markdown staged — nothing to check."
  exit 0
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "🍕 pre-commit: npm not found on PATH."
  echo "   GUI git clients often do not inherit a version manager's PATH."
  echo "   Bypass with: git commit --no-verify"
  exit 1
fi

# Enough lines for a tsc error block, short enough to read in a terminal.
readonly OUTPUT_TAIL_LINES=30

failed=()

run_check() {
  local label=$1
  shift
  printf '🐢 pre-commit: %s… ' "$label"
  local output
  if output=$("$@" 2>&1); then
    echo "ok"
  else
    echo "FAILED"
    printf '%s\n' "$output" | tail -"$OUTPUT_TAIL_LINES"
    failed+=("$label")
  fi
}

if [ "$needs_source_gate" -eq 1 ]; then
  run_check "typecheck" npm run typecheck
  run_check "tests" npm test
fi

if [ "$needs_md_lint" -eq 1 ]; then
  run_check "markdown lint" npm run lint:md
fi

if [ ${#failed[@]} -gt 0 ]; then
  echo
  echo "🍕 Hold the pizza — ${failed[*]} failed. Commit blocked."
  echo "   Fix the errors above, or bypass with: git commit --no-verify"
  exit 1
fi

echo "🐢 Cowabunga — checks passed."
exit 0
