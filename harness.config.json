{
  "version": 1,
  "name": "lego-tracker",
  "entropy": {
    "excludePatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.harness/**",
      "**/output/**"
    ]
  },
  "layers": [
    {
      "name": "types",
      "pattern": "packages/core/src/types/**",
      "allowedDependencies": []
    },
    {
      "name": "services",
      "pattern": "{packages/core/src/services/**,apps/web/src/services/**}",
      "allowedDependencies": [
        "types"
      ]
    },
    {
      "name": "domain",
      "pattern": "packages/core/src/domain/**",
      "allowedDependencies": [
        "types",
        "services"
      ]
    },
    {
      "name": "api",
      "pattern": "apps/web/src/api/**",
      "allowedDependencies": [
        "types",
        "domain",
        "services"
      ]
    }
  ],
  "entryPoints": [
    "apps/web/src/api/main.tsx",
    "packages/core/src/index.ts"
  ],
  "agentsMapPath": "./AGENTS.md",
  "docsDir": "./docs",
  "template": {
    "level": "basic",
    "version": 1
  },
  "telemetry": {
    "enabled": true
  },
  "adoption": {
    "enabled": true
  }
}
